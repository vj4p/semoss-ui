# Dev Variables
# path to the monolith server
ENDPOINT=http://localhost:9090

# name of the deployed instance (proxied at this prefix in vite.config.ts)
MODULE=/Monolith


# PLATFORM
# Used by mcp-utils.ts / tools-view.tsx to build links back to the client app.
VITE_PLATFORM_URL="../../client/dist"


## THEMING
# Without this the app has no name of its own and falls back to whatever the
# platform's Playground theme is called.
VITE_NAME="Harness"
VITE_THEME="{}"

# default model
VITE_DEFAUlT_MODEL_ID="";
VITE_DEFAUlT_MODEL_NAME="";
